{
  "info": {
    "_postman_id": "lab14-books-api-collection",
    "name": "Gankhuyag — Books API",
    "description": "F.CSM311 Бие даалт 14 — Books REST API тест collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Happy GET — List all books",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "  pm.response.to.have.header('Content-Type');",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Response has books array and total', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('books');",
                  "  pm.expect(d).to.have.property('total');",
                  "  pm.expect(d.books).to.be.an('array');",
                  "  pm.expect(d.total).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Each book has id, title, author', () => {",
                  "  const d = pm.response.json();",
                  "  d.books.forEach(book => {",
                  "    pm.expect(book).to.have.property('id');",
                  "    pm.expect(book).to.have.property('title');",
                  "    pm.expect(book).to.have.property('author');",
                  "    pm.expect(book.id).to.be.a('number');",
                  "    pm.expect(book.title).to.be.a('string');",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books",
            "description": "Бүх номын жагсаалт авах — happy path"
          }
        },
        {
          "name": "GET by id — Existing book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Book schema valid', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('id');",
                  "  pm.expect(d).to.have.property('title');",
                  "  pm.expect(d).to.have.property('author');",
                  "  pm.expect(d.id).to.be.a('number');",
                  "  pm.expect(d.title).to.be.a('string');",
                  "  pm.expect(d.author).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Correct book returned (id=1)', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.id).to.equal(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/1",
            "description": "ID=1 номыг авах"
          }
        },
        {
          "name": "POST create — Valid book (chain: saves newBookId)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Pre-request: random test data үүсгэх",
                  "const randomSuffix = Math.floor(Math.random() * 10000);",
                  "pm.environment.set('newBookTitle', 'Test Book ' + randomSuffix);",
                  "pm.environment.set('newBookAuthor', 'Test Author ' + randomSuffix);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('New book has id assigned', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('id');",
                  "  pm.expect(d.id).to.be.a('number');",
                  "  // Chain: дараагийн request-д ашиглахын тулд хадгал",
                  "  pm.environment.set('newBookId', d.id);",
                  "});",
                  "",
                  "pm.test('Returned title matches sent title', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.title).to.equal(pm.environment.get('newBookTitle'));",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{newBookTitle}}\",\n  \"author\": \"{{newBookAuthor}}\",\n  \"year\": 2024\n}"
            },
            "url": "{{baseUrl}}/books",
            "description": "Шинэ ном үүсгэх — pre-request-ээр random data, response-оос newBookId chain"
          }
        },
        {
          "name": "PUT update — Use chained newBookId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Updated title is correct', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.title).to.equal('Updated Title');",
                  "});",
                  "",
                  "pm.test('ID unchanged after update', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.id).to.equal(pm.environment.get('newBookId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"author\": \"Updated Author\",\n  \"year\": 2025\n}"
            },
            "url": "{{baseUrl}}/books/{{newBookId}}",
            "description": "POST-оос chain хийсэн newBookId ашиглан ном шинэчлэх"
          }
        },
        {
          "name": "DELETE — Use chained newBookId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content', () => {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Body is empty on 204', () => {",
                  "  pm.expect(pm.response.text()).to.equal('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{newBookId}}",
            "description": "Chain хийсэн newBookId номыг устгах"
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "GET by id — Not found 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Error message present', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('error');",
                  "  pm.expect(d.error).to.be.a('string');",
                  "  pm.expect(d.error.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/999999",
            "description": "Байхгүй id-аар GET хийж 404 шалгах — negative test"
          }
        },
        {
          "name": "POST create — Missing required fields 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response time < 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Validation error message present', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('error');",
                  "  pm.expect(d.error).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Does NOT return 201 on invalid data', () => {",
                  "  pm.expect(pm.response.status).to.not.equal(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2024\n}"
            },
            "url": "{{baseUrl}}/books",
            "description": "title, author дутуу payload явуулж 400 validation error шалгах — negative test"
          }
        },
        {
          "name": "PUT — Not found 404 (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 on update nonexistent', () => {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error body returned', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ghost\",\n  \"author\": \"Nobody\"\n}"
            },
            "url": "{{baseUrl}}/books/999999",
            "description": "Байхгүй id-аар PUT хийж 404 шалгах — negative test"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health — Server status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 500ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Status is ok', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.status).to.equal('ok');",
                  "});",
                  "",
                  "pm.test('Timestamp is ISO string', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('timestamp');",
                  "  pm.expect(new Date(d.timestamp).toString()).to.not.equal('Invalid Date');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Серверийн health check"
          }
        }
      ]
    }
  ]
}
